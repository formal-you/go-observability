# =============================================================================
# go-observability 应用侧环境变量样例
# 复制为 .env 后由 shell / docker / k8s 注入；本库只读下列键（见 telemetry）。
# 部分未列出的 OTEL_* 标准变量可能由 OTel SDK 解释；实际支持范围以 telemetry.Config 和源码为准。
# =============================================================================

# -----------------------------------------------------------------------------
# 出口开关
# -----------------------------------------------------------------------------

# OTEL_SDK_DISABLED
#   类型: bool 字符串
#   取值: true | false（大小写不敏感）
#   默认: 未设置 = false（启用 SDK）
#   说明: true 时 Config.Enabled=false，NewRuntime 不创建 Provider；
#         日志仍可经 LogConfig 的 file/stdout Writer 落盘，便于本地零依赖开发。
# OTEL_SDK_DISABLED=false

# OTEL_EXPORTER_OTLP_ENDPOINT
#   类型: string
#   格式: host:port  或  http(s)://host:port
#   默认: 未设置时 EndpointFromEnvironment() 返回 127.0.0.1:4317
#   说明: 应用启动时读取并显式写入 Config.Endpoint；只有某个信号 Output=otlp 时
#         库才会解析该地址，file/local/stdout/none 组合不受影响。
# OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317

# -----------------------------------------------------------------------------
# 资源标签（低基数；写入 Resource，Grafana 按 service.name 筛选）
# 下列 GO_OBSERVABILITY_* 由 example 读取；生产可在代码里写死或换自己的配置源。
# -----------------------------------------------------------------------------

# GO_OBSERVABILITY_REGION
#   类型: string
#   默认: 空（省略 resource 属性 region）
#   说明: 部署区域，如 cn-east-1；禁止写实例级高基数 ID。
# GO_OBSERVABILITY_REGION=cn-east-1

# GO_OBSERVABILITY_INSTANCE
#   类型: string
#   默认: 空（省略 instance）
#   说明: 实例标识，建议 pod 名短哈希或 hostname；基数需可控。
# GO_OBSERVABILITY_INSTANCE=api-0

# -----------------------------------------------------------------------------
# 下列由接入方代码 / telemetry.Config 提供，不是环境变量默认读取项；
# 列在此处便于对照「配置面」完整清单。
# -----------------------------------------------------------------------------

# SERVICE_NAME
#   对应: telemetry.ResourceConfig.ServiceName（必填）
#   示例: order-api
# SERVICE_NAME=go-observability-demo

# SERVICE_VERSION
#   对应: telemetry.ResourceConfig.ServiceVersion
#   示例: 0.1.0 / git SHA
# SERVICE_VERSION=0.1.0

# DEPLOYMENT_ENVIRONMENT
#   对应: telemetry.ResourceConfig.Environment → deployment.environment
#   示例: dev | staging | prod
# DEPLOYMENT_ENVIRONMENT=dev

# TRACE_SAMPLE_RATIO
#   对应: telemetry.TraceConfig.SampleRatio
#   类型: float (0, 1]
#   默认: 0.1（演示值；生产按流量调）
#   说明: 头部采样；按错误/慢请求做尾部保留时，必须先设 ratio=1 完整导出，
#         再在 Collector 启用 tail_sampling。
# TRACE_SAMPLE_RATIO=0.1

# METRIC_EXPORT_INTERVAL
#   对应: telemetry.MetricConfig.ExportInterval
#   默认: 15s（建议 15s–60s）
# METRIC_EXPORT_INTERVAL=15s

# TRACE_BATCH_TIMEOUT / LOG_BATCH_TIMEOUT
#   对应: telemetry.TraceConfig.BatchTimeout（默认 5s）/ telemetry.LogConfig.BatchTimeout（默认 1s）
# TRACE_BATCH_TIMEOUT=5s
# LOG_BATCH_TIMEOUT=1s

# JSONL_PATH
#   对应: telemetry.LogConfig.FilePath
#   默认: 由 example 决定，如 logs/events.jsonl
# JSONL_PATH=logs/events.jsonl
