# =============================================================================
# go-observability 应用侧环境变量样例
# 复制为 .env 后由 shell / docker / k8s 注入；本库只读下列键（见 internal/telemetry）。
# 未列出的 OTEL_* 标准变量仍可由 OTel SDK 自行解释（本库显式 WithEndpointURL 时 endpoint 以本文件为准）。
# =============================================================================

# -----------------------------------------------------------------------------
# B9 出口开关
# -----------------------------------------------------------------------------

# OTEL_SDK_DISABLED
#   类型: bool 字符串
#   取值: true | false（大小写不敏感）
#   默认: 未设置 = false（启用 SDK）
#   说明: true 时 SetupFromEnvironment 返回空 Providers（trace/metric/log 全 noop）；
#         日志仍可通过 file/stdout Writer 落盘，便于本地零依赖开发。
# OTEL_SDK_DISABLED=false

# OTEL_EXPORTER_OTLP_ENDPOINT
#   类型: string
#   格式: host:port  或  http(s)://host:port
#   默认: 未设置时 EndpointFromEnvironment() 返回 127.0.0.1:4317（仅作 Setup 默认）
#   说明: NewLogWriter 用「环境变量是否非空」判断走 OTLP 还是 JSONL：
#         - 未设置或空 → file Writer（本地 JSONL）
#         - 非空且 Providers 已启用 → OTLP Writer
#         与 docker-compose 中 collector 映射端口对齐：127.0.0.1:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317

# -----------------------------------------------------------------------------
# A7 资源标签（低基数；写入 Resource，Grafana 按 service.name 筛选）
# 下列 GO_OBSERVABILITY_* 由 example 读取；生产可在代码里写死或换自己的配置源。
# -----------------------------------------------------------------------------

# GO_OBSERVABILITY_REGION
#   类型: string
#   默认: 空（省略 resource 属性 region）
#   说明: 部署区域，如 cn-east-1；禁止写实例级高基数 ID。
# GO_OBSERVABILITY_REGION=cn-east-1

# GO_OBSERVABILITY_INSTANCE
#   类型: string
#   默认: 空（省略 instance）
#   说明: 实例标识，建议 pod 名短哈希或 hostname；基数需可控。
# GO_OBSERVABILITY_INSTANCE=api-0

# -----------------------------------------------------------------------------
# 下列由接入方代码 / telemetry.Config 提供，不是环境变量默认读取项；
# 列在此处便于对照「配置面」完整清单。
# -----------------------------------------------------------------------------

# SERVICE_NAME
#   对应: telemetry.Config.ServiceName（必填）
#   示例: order-api
# SERVICE_NAME=go-observability-demo

# SERVICE_VERSION
#   对应: telemetry.Config.ServiceVersion
#   示例: 0.1.0 / git SHA
# SERVICE_VERSION=0.1.0

# DEPLOYMENT_ENVIRONMENT
#   对应: telemetry.Config.Environment → deployment.environment
#   示例: dev | staging | prod
# DEPLOYMENT_ENVIRONMENT=dev

# TRACE_SAMPLE_RATIO
#   对应: telemetry.Config.TraceSampleRatio
#   类型: float (0, 1]
#   默认: 0.1（演示值；生产按流量调）
#   说明: 头部采样；错误必采需 collector tail_sampling 或 ratio=1
# TRACE_SAMPLE_RATIO=0.1

# METRIC_EXPORT_INTERVAL
#   对应: telemetry.Config.MetricExportInterval
#   默认: 15s（建议 15s–60s）
# METRIC_EXPORT_INTERVAL=15s

# TRACE_BATCH_TIMEOUT / LOG_BATCH_TIMEOUT
#   对应: TraceBatchTimeout（默认 5s）/ LogBatchTimeout（默认 1s）
# TRACE_BATCH_TIMEOUT=5s
# LOG_BATCH_TIMEOUT=1s

# JSONL_PATH
#   对应: Providers.NewLogWriter(ctx, jsonlPath) 第二参数
#   默认: 由 example 决定，如 logs/events.jsonl
# JSONL_PATH=logs/events.jsonl
